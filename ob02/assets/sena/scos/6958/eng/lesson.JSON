ntents": [{"content": "Civil rights leaders were", "type": "text"}]}, {"type": "incorrect", "contents": [{"content": "good-respect", "type": "text"}]}, {"type": "post_question", "contents": {"content": "for their outspokenness. ", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "id": 2}], "_data": [{"type": "instructions", "contents": [{"content": " \nIt was an important time in history.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: \n<span class=\"bullet\">Proofread the sentence.</span> \n<span class=\"bullet\">Click on the incorrect word.</span> \n<span class=\"bullet\">Type in the correct word to complete the sentence.\n</span> <span class=\"bullet\">Use capital letters where necessary.</span>\n", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}]}], "id": 9, "stimuli_ids": []}, {"template_override": 1, "type": "RSLT", "questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "id": 0, "correct": 0, "selected": 0}, {"_data": [{"content": "", "type": "text"}], "id": 1, "correct": 1, "selected": 0}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "id": 0, "correct": 1, "selected": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn11le14ob02re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " \nWatch <span class=\"italic\">Selma</span>.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Listening", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self-Assessment.\n", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "title": "", "_data": [], "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn11le14ob02re2aud01", "coverimg": "engenn11le14ob02re2img03.jpg", "images": [{"image": "engenn11le14ob02re2img03.jpg", "text": "", "time": "0", "id": 0}, {"image": "engenn11le14ob02re2img03.jpg", "text": "It's hard to believe people in America did not have equal rights in the 1950's and that the Civil Rights Movement, and people like Rosa Parks had to fight for justice. <br/>\nOne December evening in 1955, Rosa Parks was riding the bus after she finished a day at work as a dressmaker. She was sitting in the \u201ccolored section\u201d when the bus stopped to let more passengers on. When the bus driver ordered all African-American passengers to give up their seats for the white people, everybody complied except Rosa Parks, who was not only exhausted and sore after a day's work, but determined to keep her seat. After she refused to give up her seat, she was arrested and fined. The incident led to the famous Montgomery boycott in which citizens collectively refused to take the buses until the law was changed.", "time": "0", "id": 1}, {"image": "engenn11le14ob02re2img01.jpg", "text": "Before Rosa was arrested, two other women challenged the same law. It was because Rosa was courageous and well-respected that she was able to draw enough attention to the incident and gain white support.<br/>\nAs the lawsuits were making their way up to the Supreme Court, Montgomery's white citizens were becoming violent and angry. The boycotters persisted and gained media attention. Finally, bus segregation was ruled unconstitutional on November 13th, 1956.", "time": "52000", "id": 2}, {"image": "engenn11le14ob02re2img02.jpg", "text": "Despite this success, Rosa was being harassed and threatened, so she and her family moved to Detroit, where she became an administrative aide. <br/> It is not surprising that Rosa Parks is known as the \u201cmother of the Civil Rights Movement.\u201d", "time": "84000", "id": 3}]}}], "id": 1}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Making a Difference", "type": "lesson_name"}, {"content": "Rosa Parks", "type": "unit_name"}, {"content": 2, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 14, "type": "lesson"}, {"content": "B2.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": " Describe the reasons or results of events or actions in spoken or written texts, in work and social contexts.", "type": "primary"}, {"content": " Understands the main ideas and specific information of a complex text on both concrete and abstract topics, including technical issues in a specific field of specialization in written texts in social and work contexts.", "type": "secondary_1"}, {"content": " Understands the main ideas and specific information of a complex text on both concrete and abstract topics, including technical issues in a specific field of specialization in written texts in social and work contexts.", "type": "secondary_2"}, {"content": " Understands the main ideas and specific information of a complex text on both concrete and abstract topics, including technical issues in a specific field of specialization in written texts in social and work contexts.", "type": "secondary_3"}, {"content": " Understands the main ideas and specific information of a complex text on both concrete and abstract topics, including technical issues in a specific field of specialization in written texts in social and work contexts.", "type": "secondary_4"}, {"content": " Understands the main ideas and specific information of a complex text on both concrete and abstract topics, including technical issues in a specific field of specialization in written texts in social and work contexts.", "type": "secondary_5"}, {"content": " Understands the main ideas and specific information of a complex text on both concrete and abstract topics, including technical issues in a specific field of specialization in written texts in social and work contexts.", "type": "secondary_6"}, {"content": " Understands the main ideas and specific information of a complex text on both concrete and abstract topics, including technical issues in a specific field of specialization in written texts in social and work contexts.", "type": "secondary_7"}, {"content": " Understands the main ideas and specific information of a complex text on both concrete and abstract topics, including technical issues in a specific field of specialization in written texts in social and work contexts.", "type": "secondary_8"}]}, {"content": "engenn11le14ob02re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " Past Continuous Tense", "type": "heading"}, {"content": "You can use the past continuous to talk about events that were in progress at a time in the past.", "type": "describer"}, {"content": "To form the past continuous, you need:<br/> <div class=\"center_text\"><span class=\"strong\">be (was/were) + present participle (verb \u2013ing)</span></span>", "type": "text"}, {"content": "Remember that you do not usually use continuous verb tenses with stative verbs. These are verbs that show thoughts, emotions and states. Some of these verbs include <span class=\"italic\">like, love, hate, want, need, think, understand, be</span> and <span class=\"italic\">have</span> (for possession).<br/> <span class=\"italic\"><ul><li>NOT: I was liking the chocolate cake at the restaurant. <li>I <span class=\"strong\">liked</span> the chocolate cake at the restaurant. <li>NOT: I was having a car in 2003. <li>I <span class=\"strong\">had</span> a car in 2003.</li></ul></span>", "type": "text"}, {"content": "You can use the past continuous to talk about actions that were happening at a specific time in the past. <span class=\"italic\"><ul><li>I <span class=\"strong\">was making</span> breakfast at 7 a.m. yesterday morning.</li></ul></span>   The emphasis when you use the past continuous is on the progress of the action. This verb tense does not say that the action has been completed. <ul><li><span class=\"italic\">I <span class=\"strong\">was writing</span> an essay last night. </span> <ul><li>(This emphasizes the duration of the action. As this verb tense does not describe a finished action, it suggests that the essay was not finished.)</li></ul></i:> <li><span class=\"italic\">It <span class=\"strong\">was snowing</span> all night. </span> <ul><li>(The focus is on the duration of the event and that there was snow throughout the night.)</li></ul></i:>", "type": "text"}, {"content": "Compare this to the use of the simple past: <ul><li><span class=\"italic\">I wrote an essay last night. </span> <ul><li>(I finished the entire essay last night from the beginning to the end.)</li></ul></i:> <li><span class=\"italic\">It snowed all night. </span> <ul><li>(The event was one complete event and it snowed from the beginning to the end of the night.)</li></ul></i:>", "type": "text"}, {"content": "If you want to talk about two actions that were happening at the same time, you can use <span class=\"strong\">while</span> with the past continuous. <span class=\"italic\"><ul><li>I <span class=\"strong\">was doing</span> work on the computer while my aunt <span class=\"strong\">was cleaning</span> the kitchen.</li></ul></span>", "type": "text"}, {"content": "You can use <span class=\"strong\">all evening</span>, <span class=\"strong\">all night</span>, <span class=\"strong\">all weekend</span>, and other adverbials with<span class=\"strong\"> all </span>to show that an action was in progress during this time. <span class=\"italic\"><ul><li>I <span class=\"strong\">was cooking</span> all day yesterday. <li><span class=\"strong\">Were</span> you <span class=\"strong\">exercising</span> all morning?</li></ul></span><span class=\"prelo-letter-page-break\"></span>", "type": "text"}, {"content": "One December evening in 1955, Rosa Parks was riding the bus after she finished a day at work as a dressmaker. ", "type": "example"}, {"content": "She was sitting in the \u201ccolored section\u201d when the bus stopped to let more passengers on. ", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " Time Clause: Interrupted Events", "type": "heading"}, {"content": " You can use the past continuous tense with different time words to show that an action was interrupted.", "type": "describer"}, {"content": "You can use the past continuous with the simple past to show that an action interrupted another action in the past. <br/> The action in the continuous tense is the action that was happening when another action (in the simple past) occurred.", "type": "text"}, {"content": "<span class=\"italic\">They <span class=\"strong\">were watching</span> a movie when the lights <span class=\"underline\">went out</span>. <br/>When the lights <span class=\"underline\">went out</span>, they <span class=\"strong\">were watching</span> a movie.</span>", "type": "text"}, {"content": "<span class=\"italic\">(past continuous + when + simple past for the interrupting action)", "type": "text"}, {"content": "<span class=\"italic\">While I <span class=\"strong\">was chopping up</span> the vegetables for dinner, I <span class=\"underline\">cut</span> myself. <br/> I <span class=\"underline\">cut</span> myself while I <span class=\"strong\">was chopping up</span> the vegetables for dinner.</span>", "type": "text"}, {"content": "<span class=\"italic\">(while + past continuous + simple past for the interrupting action)", "type": "text"}, {"content": "You can put either clause first, but remember to use a comma after the time clause (with <span class=\"strong\">when</span> or <span class=\"strong\">while</span> as in the examples above).", "type": "text"}, {"content": "If you want to talk about order of events, you can use <span class=\"strong\">after</span>, <span class=\"strong\">before</span> and <span class=\"strong\">until</span>.", "type": "text"}, {"content": "<span class=\"italic\">I washed the blood off my finger <span class=\"strong\">before</span> I put on a Band-Aid.<br/> I continued chopping vegetables <span class=\"strong\">after</span> I bandaged my finger.<br/> The Band-Aid stayed on my finger <span class=\"strong\">until</span> I took a shower and it fell off.</span>", "type": "text"}, {"content": "After she refused to give up her seat, she was arrested and fined. ", "type": "example"}, {"content": "The incident led to the famous Montgomery boycott in which citizens collectively refused to take the buses until the law was changed.", "type": "example"}, {"content": "Before Rosa was arrested, two other women challenged the same law. ", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "dressmaker", "type": "name"}, {"content": "a person whose job is making women's clothes", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: One December evening in 1955, Rosa Parks was riding the bus after she finished a day at work as a dressmaker. ", "type": "example"}, {"content": "engenn11le14ob02aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use to talk about social issues.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "unconstitutional", "type": "name"}, {"content": "not in accordance with a political constitution", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Finally, bus segregation was ruled unconstitutional on November 13th, 1956. ", "type": "example"}, {"content": "engenn11le14ob02aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "collectively", "type": "name"}, {"content": "as a group", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example: The incident led to the famous Montgomery Boycott in which citizens collectively refused to take the buses until the law was changed.", "type": "example"}, {"content": "engenn11le14ob02aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "well-respected", "type": "name"}, {"content": "admired by many", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: It was because Rosa was courageous and well-respected that she was able to draw enough attention to the incident and gain white support.", "type": "example"}, {"content": "engenn11le14ob02aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to draw attention", "type": "name"}, {"content": "to cause people to focus on something or someone", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: It was because Rosa was courageous and well-respected that she was able to draw enough attention to the incident and gain white support.", "type": "example"}, {"content": "engenn11le14ob02aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to harass", "type": "name"}, {"content": "to \u200bannoy or \u200btrouble someone \u200brepeatedly ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Rosa was being harassed and threatened so she and her family moved to Detroit, where she became an administrative aide. ", "type": "example"}, {"content": "engenn11le14ob02aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "boycott", "type": "name"}, {"content": "to withdraw from commercial or social relations as a form of punishment or protest", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The incident led to the famous Montgomery Boycott in which citizens collectively refused to take the buses until the law was changed.", "type": "example"}, {"content": "engenn11le14ob02aud02", "type": "audio"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I watch a film about social issues.", "type": "text"}, {"content": "I write notes on key events.", "type": "text"}, {"content": "I write about things that were happening and about interrupted events.", "type": "text"}, {"content": "I read my summary aloud.", "type": "text"}, {"content": "I discuss the issues from the film with a friend.", "type": "text"}]}, {"type": "takeaway_extension", "contents": [{"content": "Find the film <span class=\"italic\">Selma</span> and watch it.", "type": "text"}, {"content": "Take notes on the key events in the plot.", "type": "text"}, {"content": "Write a summary of the movie using interrupted events and events that were happening.", "type": "text"}, {"content": "Read your summary to someone.", "type": "text"}, {"content": "Discuss the issues raised in the film.", "type": "text"}]}]}